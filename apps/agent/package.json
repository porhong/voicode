{
  "name": "@anantbot/voicecode-agent",
  "version": "0.1.3",
  "description": "Turn your PC into a local server for voice-controlled Claude Code and desktop mouse control from any browser on your LAN",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "voice",
    "remote-control",
    "trackpad",
    "mouse",
    "cli",
    "agent"
  ],
  "homepage": "https://github.com/porhong/voicode#readme",
  "bugs": {
    "url": "https://github.com/porhong/voicode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/porhong/voicode.git",
    "directory": "apps/agent"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "voicecode-agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "native-bin",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "os": [
    "win32",
    "linux"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-web.mjs",
    "dev": "tsx watch src/cli/index.ts start",
    "start": "node dist/cli.js start",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node scripts/prepack.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@peculiar/x509": "^2.2.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "commander": "^15.0.0",
    "fastify": "^5.12.7",
    "picocolors": "^1.1.1",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.2",
    "@voicecode/protocol": "*",
    "@voicecode/security": "*",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  }
}
